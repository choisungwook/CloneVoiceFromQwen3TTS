{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/python-lint.sh",
            "timeout": 30,
            "statusMessage": "Running Python lint (black + ruff)..."
          }
        ]
      }
    ]
  }
}
